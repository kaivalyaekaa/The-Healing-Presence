# =====================================================================
# DEV ONLY — never deploy this file to production.
# Production must use a real corporate LDAP/AD with hashed passwords
# (set spring.ldap.urls + spring.ldap.username/password and remove the
# embedded LDAP starter from the runtime classpath).
# =====================================================================
dn: dc=healingpresence,dc=local
objectClass: top
objectClass: domain
dc: healingpresence

dn: ou=people,dc=healingpresence,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=healingpresence,dc=local
objectClass: organizationalUnit
ou: groups

dn: uid=admin,ou=people,dc=healingpresence,dc=local
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: Site Administrator
sn: Administrator
uid: admin
mail: admin@healingpresence.local
userPassword: admin123

dn: uid=therapist,ou=people,dc=healingpresence,dc=local
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: Resident Therapist
sn: Therapist
uid: therapist
mail: therapist@healingpresence.local
userPassword: therapist123

dn: uid=reception,ou=people,dc=healingpresence,dc=local
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: Front Desk Receptionist
sn: Receptionist
uid: reception
mail: reception@healingpresence.local
userPassword: reception123

dn: cn=ADMIN,ou=groups,dc=healingpresence,dc=local
objectClass: top
objectClass: groupOfUniqueNames
cn: ADMIN
uniqueMember: uid=admin,ou=people,dc=healingpresence,dc=local

dn: cn=STAFF,ou=groups,dc=healingpresence,dc=local
objectClass: top
objectClass: groupOfUniqueNames
cn: STAFF
uniqueMember: uid=admin,ou=people,dc=healingpresence,dc=local
uniqueMember: uid=therapist,ou=people,dc=healingpresence,dc=local

dn: cn=RECEPTIONIST,ou=groups,dc=healingpresence,dc=local
objectClass: top
objectClass: groupOfUniqueNames
cn: RECEPTIONIST
uniqueMember: uid=admin,ou=people,dc=healingpresence,dc=local
uniqueMember: uid=reception,ou=people,dc=healingpresence,dc=local
